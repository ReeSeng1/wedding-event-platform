generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         Int       @id@default(autoincrement())
  email      String    @unique
  password   String 
  role       String    @default("ADMIN")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
} 

model Vendor {
  id                    Int               @id @default(autoincrement())
  businessName          String  
  ownerName             String
  email                 String            @unique
  phoneNumber           String     
  password              String
  category              String
  location              String            @default("")
  description           String            @default("")
  serviceName           String            @default("")
  serviceDescription    String            @default("")
  servicePrice          String            @default("")
  portfolioTitle        String            @default("")
  portfolioDescription  String            @default("")
  portfolioImage        String            @default("")
  status                String            @default("Pending")
  selectedEvents        SelectedVendor[]
  createdAt             DateTime 
  updatedAt             DateTime
}

model EventRequest {
  id               String                @id @default(cuid())
  clientName       String
  phoneNumber      String
  eventType        String
  eventDate        String
  eventLocation    String                @default("")
  guestCount       String                @default("")
  budget           String                @default("")
  message          String                @default("")
  status           String                @default("Pending")
  SelectedVendors  SelectedVendor[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
}

model SelectedVendor {
  id               String     @id @default(cuid())
  eventRequestId   String
  vendorId         Int
  category         String

  eventRequest  EventRequest  @relation(fields: [eventRequestId], references: [id], onDelete: Cascade)
  vendor        Vendor        @relation(fields: [vendorId], references: [id], onDelete:Cascade)

  @@unique([eventRequestId, vendorId])
}